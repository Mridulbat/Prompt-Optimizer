{
    "manifest_version": 3,
    "name": "Prompt Optimizer",
    "version": "1.0",

    "permissions": [
        "storage"
    ],

    "host_permissions": [
        "http://localhost:3000/*"
    ],

    "content_scripts": [
        {
            "matches": [
                "https://claude.ai/*",
                "https://chatgpt.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ]
        }
    ]
}